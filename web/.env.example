# Copy this file to .env and fill in your local values. .env is git-ignored.

PORT=4000

# SQL Server (see the Docker setup in the root README)
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=CDC_Demo
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=
SQL_SERVER_ENVIRONMENT=Docker (localhost)
# Container name used by the "Reset SQL Server data" admin button (docker cp + sqlcmd)
SQL_SERVER_DOCKER_CONTAINER=sqlserver2022

# RavenDB
RAVENDB_URL=http://127.0.0.1:8725
RAVENDB_DATABASE=CDC-Demo
RAVENDB_ENVIRONMENT=Local
